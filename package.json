{
  "name": "niimbot-studio",
  "productName": "Niimbot Studio",
  "version": "0.1.0",
  "description": "Design and print labels on NIIMBOT thermal printers",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && prettier --check src",
    "dist": "npm run typecheck && electron-vite build && electron-builder --publish never",
    "release": "npm run typecheck && electron-vite build && electron-builder --publish always",
    "format": "prettier --write src"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@mmote/niimbluelib": "^0.49.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  },
  "author": {
    "name": "blonestar"
  },
  "license": "MIT",
  "homepage": "https://github.com/blonestar/niimbot-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/blonestar/niimbot-studio.git"
  },
  "desktopName": "niimbot-studio.desktop"
}
